# Copy to .env and fill in one provider. Never commit the real .env.

# --- Google Gemini (cloud) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (local, nothing leaves the machine) ---
# With GEMINI_API_KEY set, OLLAMA_MODEL is also used as the fallback when a cloud request fails.
# WINGMAN_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434
