# Curb Connect API settings. Set these as environment variables on the server.

# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=
APP_ENV=production

# SQLite file by default. For production use PostgreSQL, e.g.
# postgresql+psycopg://user:password@host:5432/curbconnect  (also pip install "psycopg[binary]")
DATABASE_URL=

# Where uploaded job files are stored, and the per-file limit.
UPLOAD_DIR=
MAX_UPLOAD_MB=25

# The web app's address: allowed for CORS and used to build invite links.
CORS_ORIGINS=https://app.example.com
APP_URL=https://app.example.com

# How long a sign-in lasts, in minutes.
ACCESS_TOKEN_MINUTES=720
