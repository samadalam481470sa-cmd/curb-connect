# Copy to .env.local and fill in. Leave a value empty to use the default.

# Licensed satellite imagery as an XYZ tile URL, e.g. https://tiles.example.com/{z}/{x}/{y}.jpg?key=YOUR_KEY
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=

# Nominatim-compatible geocoder search endpoint.
VITE_GEOCODER_URL=
