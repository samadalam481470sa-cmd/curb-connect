# Copy to .env.local (never commit it). Same database the API uses.
SWATH_DATABASE_URL=
# Fetch every 30 minutes (MRMS publishes a new file every 30 minutes).
SWATH_INTERVAL_MINUTES=30
# Health endpoint (Render sets PORT; SWATH_PORT wins locally).
SWATH_HOST=127.0.0.1
SWATH_PORT=4310
# Optional: override the MRMS directory (tests) or a scratch dir for downloads.
# SWATH_MESH_BASE_URL=https://mrms.ncep.noaa.gov/2D/MESH_Max_1440min/
# SWATH_WORK_DIR=/tmp/swath-worker
