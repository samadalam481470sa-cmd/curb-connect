# apps/api environment. Copy to apps/api/.env.local (git-ignored) and fill in real values.
# Real environment variables always override these files. Validated at startup by src/config.ts.

NODE_ENV=development
LOG_LEVEL=info

# HTTP
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
TRUST_PROXY=false

# PostgreSQL 17 + PostGIS. TEST_DATABASE_URL's database name must end in "_test".
DATABASE_URL=postgres://fieldline:<password>@localhost:54329/fieldline_dev
TEST_DATABASE_URL=postgres://fieldline:<password>@localhost:54329/fieldline_test
DATABASE_POOL_MAX=10

# Sessions: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<random-secret-at-least-32-chars>
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=168

# OIDC: Microsoft Entra ID (sign-in is shown as unavailable until all three are set)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OIDC: local stand-in provider (infra/dev-idp). Development/test only; rejected in production.
DEV_IDP_ISSUER=http://localhost:4100
DEV_IDP_CLIENT_ID=
DEV_IDP_CLIENT_SECRET=

# Object storage: "local" = AES-256-GCM encrypted files under STORAGE_LOCAL_DIR; "s3" = S3-compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/objects
# base64 of 32 random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=<base64-32-byte-key>
STORAGE_MAX_UPLOAD_BYTES=26214400
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Vision worker (services/vision)
VISION_URL=http://localhost:4200

# Imagery (visualization-only providers; analysis rights are enforced in code)
GOOGLE_MAP_TILES_API_KEY=

# Mail (unset = messages are recorded but not sent)
SMTP_URL=
MAIL_FROM=

# Payments (unset = payment capture unavailable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telemetry (unset = tracing is a no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api

# Runtime connection as a restricted role (NOSUPERUSER NOBYPASSRLS) so Row-Level Security is enforced.
APP_DATABASE_URL=postgres://fieldline_app:CHANGE_ME@localhost:54329/fieldline_dev
TEST_APP_DATABASE_URL=postgres://fieldline_app:CHANGE_ME@localhost:54329/fieldline_test
