# apps/mailer environment. Copy to apps/mailer/.env.local (git-ignored) and fill in real values.
# These keys belong to this mail server only. Do not reuse the Newport CRM's client IDs or secrets,
# and do not reuse the API's Microsoft sign-in app: create the two app registrations described in
# docs/email-sending.md. Generate the two random secrets with:  npm run keys -w @fieldline/mailer

NODE_ENV=development
LOG_LEVEL=info

# HTTP. MAILER_PUBLIC_ORIGIN is what browsers and Google/Microsoft redirects use.
MAILER_HOST=127.0.0.1
MAILER_PORT=4300
MAILER_PUBLIC_ORIGIN=http://localhost:4300
# Where people land after connecting a mailbox (the Field Pro web app).
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Shared with apps/api (same value in both). Signs connect tickets and API -> mailer calls.
MAILER_SHARED_SECRET=<random-secret-at-least-32-chars>
# base64 of 32 random bytes. Encrypts stored refresh tokens (AES-256-GCM). Losing it means every
# member reconnects; changing it does the same.
MAILER_TOKEN_ENCRYPTION_KEY=<base64-32-byte-key>

# Storage. Empty MAILER_DATABASE_URL = encrypted JSON file at MAILER_DATA_FILE (fine for one machine).
# Set a postgres:// URL in production; tables are created in the "mailer" schema on start.
MAILER_DATABASE_URL=
MAILER_DATA_FILE=.data/mailboxes.json

# Google Cloud OAuth client (type "Web application"), Gmail API enabled.
# Authorized redirect URI: <MAILER_PUBLIC_ORIGIN>/oauth/gmail/callback
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# Microsoft Entra app registration ("Any Entra ID tenant + personal Microsoft accounts"),
# platform "Web", delegated Graph permissions Mail.Send, User.Read, offline_access.
# Redirect URI: <MAILER_PUBLIC_ORIGIN>/oauth/outlook/callback
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT=common
