# Copy this file to .env and fill in your own values. Never commit .env.
# Use keys made for this server only. Do not reuse keys from other apps.

# Where the server listens. Keep 127.0.0.1 unless it runs behind HTTPS.
HOST=127.0.0.1
PORT=4500
# The address you open in the browser. The OAuth redirect URIs are built from it.
PUBLIC_URL=http://localhost:4500

# SQLite file for accounts, sessions and mail connections (the .data folder is git-ignored).
DATABASE_PATH=.data/mail-connect.db

# 32 random bytes as 64 hex characters. Encrypts the stored Gmail/Outlook tokens.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Google Cloud: Web OAuth client with redirect URI http://localhost:4500/auth/gmail/callback
# Used for "Sign in with Google" and for connecting Gmail to send invoices.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra: app registration with redirect URI http://localhost:4500/auth/outlook/callback
# Used for "Sign in with Microsoft" and for connecting Outlook to send invoices.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = work, school and personal Microsoft accounts. Use your tenant ID to limit it.
MICROSOFT_TENANT=common
