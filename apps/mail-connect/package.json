{
  "name": "@fieldline/mail-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Curb Connect mail server: user accounts, sign-in, and invoice email through each user's own Gmail or Outlook.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
