# Copy to .env.local and fill in. Everything works without keys; keys unlock providers below.

# Address of the Curb Connect API (server/). When set, the app requires sign-in and shares jobs,
# files, and invoices between contractor and subcontractor with live updates. Leave empty for the
# single-browser demo.
VITE_API_URL=

# Google Maps Platform key with the Map Tiles API and Geocoding API enabled.
# When set, the map uses Google satellite imagery and Google address search.
# Restrict the key to your site's domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# ArcGIS Location Platform key (free tier available). Recommended for commercial use of the
# default Esri satellite imagery and worldwide address search.
VITE_ARCGIS_API_KEY=
