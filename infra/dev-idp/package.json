{
  "name": "@fieldline/dev-idp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stand-in OpenID Connect provider for development and tests only. Never deploy.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "oidc-provider": "^9.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "^9.12.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
