{
  "name": "fieldline",
  "version": "0.1.0",
  "private": true,
  "description": "Fieldline: multi-tenant contractor platform for Roof Measurements and Concrete Curb Cutting.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/dev-idp"
  ],
  "scripts": {
    "dev": "concurrently --names api,web,idp,vision --prefix-colors blue,green,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:idp\" \"npm:dev:vision\"",
    "dev:api": "npm run dev -w @fieldline/api",
    "dev:web": "npm run dev -w @fieldline/web",
    "dev:idp": "npm run dev -w @fieldline/dev-idp",
    "dev:vision": "node infra/scripts/run-vision.mjs serve",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration -w @fieldline/api",
    "test:vision": "node infra/scripts/run-vision.mjs test",
    "test:e2e": "npm run test:e2e -w @fieldline/web",
    "db:migrate": "npm run db:migrate -w @fieldline/api",
    "db:seed": "npm run db:seed -w @fieldline/api",
    "db:reset:test": "npm run db:reset:test -w @fieldline/api",
    "demo:sprint0": "npm run demo:sprint0 -w @fieldline/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "traceability": "node scripts/traceability/generate.mjs && prettier --write docs/traceability.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "protobufjs": false
  }
}
